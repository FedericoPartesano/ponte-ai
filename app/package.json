{
  "name": "@ponte-ai/app",
  "productName": "Ponte AI",
  "version": "0.1.6",
  "private": true,
  "author": "Federico Partesano",
  "type": "module",
  "description": "App Windows con icona nella barra: collega il PC agli assistenti AI dei progetti",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/dist-win.mjs",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "@ponte-ai/core": "*",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.0.0",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.ponteai.app",
    "productName": "Ponte AI",
    "files": [
      "main.mjs",
      "preload.cjs",
      "ui/**",
      "icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "icon.png",
      "executableName": "ponte-ai",
      "artifactName": "ponte-ai-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "artifactName": "ponte-ai-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Utility",
      "executableName": "ponte-ai",
      "syncDesktopName": true
    },
    "executableName": "ponte-ai",
    "publish": null,
    "afterPack": "scripts/after-pack.cjs"
  },
  "homepage": "https://github.com/FedericoPartesano/ponte-ai",
  "desktopName": "ponte-ai.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/FedericoPartesano/ponte-ai.git"
  },
  "shortVersionWindows": "0.1.6"
}
